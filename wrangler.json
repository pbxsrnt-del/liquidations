{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquidations",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/data/live.js",
      "/data/live",
      "/photos/*",
      "/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liquidations",
      "database_id": "77bec7f7-d849-4166-9841-110571ca9e1e"
    }
  ],
  "observability": {
    "enabled": true
  }
}
